// Esquema de datos de la API. Identificadores en inglés; comentarios en español.
// La URL de conexión vive en ../prisma.config.ts (Prisma 7 no la acepta aquí).

generator client {
  provider     = "prisma-client"
  output       = "../src/db/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Profesional del panel privado. Su slug es el identificador de su página pública.
model Professional {
  id                   String                @id @default(uuid())
  name                 String
  email                String                @unique
  passwordHash         String
  slug                 String                @unique
  timezone             String                @default("America/Santiago")
  services             Service[]
  weeklyTemplateRanges WeeklyTemplateRange[]
}

/// Tipo de cita que ofrece un profesional. La página pública solo muestra los activos.
model Service {
  id              String       @id @default(uuid())
  professionalId  String
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  isActive        Boolean      @default(true)

  @@index([professionalId])
}

/// Rango de atención de un día de la semana. Un día sin rangos no atiende.
model WeeklyTemplateRange {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  /// 0 = domingo … 6 = sábado, como getDay() de date-fns.
  weekday        Int
  /// Horas «HH:mm» en la zona del profesional; con dos dígitos se comparan como texto.
  startTime      String
  endTime        String

  @@index([professionalId])
}
