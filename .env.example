# Postgres local de docker-compose. Si la clave tiene #, @ u otros símbolos, ponla entre comillas.
DB_USER=neuralcode
DB_PASSWORD="cambia-esta-clave"
DB_NAME=generic_scheduling
DB_PORT=5434

# Conexión de la API a la base de desarrollo. Usa las mismas credenciales de arriba.
# Si la clave tiene símbolos, codifícala para URL (por ejemplo, @ es %40 y # es %23).
DATABASE_URL="postgresql://neuralcode:cambia-esta-clave@localhost:5434/generic_scheduling"

# Firma del JWT de sesión del profesional (mínimo 32 caracteres). Genera uno con: openssl rand -base64 48
JWT_SECRET_PROFESSIONAL="cambia-este-secreto-de-al-menos-32-caracteres"
